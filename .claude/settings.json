{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter pub deps:*)",
      "Bash(flutter pub outdated:*)",
      "Bash(flutter doctor:*)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git grep:*)",
      "PowerShell(flutter analyze:*)",
      "PowerShell(flutter test:*)",
      "PowerShell(flutter pub get:*)",
      "PowerShell(dart format:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dart-post-edit.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
