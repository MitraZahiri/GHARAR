rules_version = '2';

// GHARAR: a user's profile is visible only to them; a couple's data only to
// the (at most two) Firebase users listed in the couple's memberUids.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCoupleMember(coupleId) {
      let couple = get(/databases/$(database)/documents/couples/$(coupleId));
      return signedIn() && couple != null
        && request.auth.uid in couple.data.memberUids;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /couples/{coupleId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.memberUids == [request.auth.uid];
      // Members may edit, but cannot remove themselves or add a third person.
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() <= 2;
      // A partner joins with the couple's invite code while it has one member,
      // adding only themselves and their partner profile.
      allow update: if signedIn()
        && resource.data.memberUids.size() == 1
        && request.resource.data.memberUids
          == resource.data.memberUids.concat([request.auth.uid])
        && request.resource.data.joinCode == resource.data.inviteCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['memberUids', 'joinCode', 'partner2', 'isLinked', 'updatedAt']);
      allow delete: if false;

      match /{collection}/{docId} {
        allow read, write: if isCoupleMember(coupleId)
          && collection in ['answers', 'loveNotes', 'journal', 'specialDates'];
      }
    }

    // Looked up one code at a time (no listing), so codes can't be browsed.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow delete: if isCoupleMember(resource.data.coupleId);
    }
  }
}
